# NetraPack backend environment configuration (placeholders only - no real keys).
# Copy to .env and fill in real values. .env is gitignored.

# App
APP_NAME=netrapack-backend
APP_ENV=development
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000

# Level 2 cloud AI (Gemini). Use a current "AQ." auth key from Google AI Studio.
GEMINI_API_KEY=your_gemini_auth_key_here
GEMINI_MODEL=gemini-3.6-flash
# Tried automatically if GEMINI_MODEL returns a transient/server error (429/500/503)
# or is unavailable (404). "gemini-flash-latest" tracks a current flash model.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Level 1 local AI (Ollama). Generous timeout for CPU inference.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=180

# OCR: only needed if the tesseract binary is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Local SQLite database directory (defaults to ./data). Kept out of Git.
# NETRAPACK_DB_DIR=./data

# Reserved for Day 3+ (barcode lookup / reference DB) - not used yet.
# BARCODE_LOOKUP_API_KEY=your_barcode_key_here
